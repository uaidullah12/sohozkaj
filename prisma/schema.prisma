// Prisma schema - PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  phone     String?  @unique
  password  String
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile   Profile?
  images    Image[]
  sessions  Session[]
}

model Profile {
  id      String @id @default(cuid())
  user    User   @relation(fields: [userId], references: [id])
  userId  String @unique
  name    String?
  avatar  String?
  bio     String?
}

model Session {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  token     String
  createdAt DateTime @default(now())
}

model Image {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  filename   String
  url        String
  width      Int?
  height     Int?
  size       Int?
  createdAt  DateTime @default(now())
  projectId  String?
}

model Project {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  title     String
  data      Json
  createdAt DateTime @default(now())
}

model Document {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  title     String
  url       String
  metadata  Json?
  createdAt DateTime @default(now())
}

model Job {
  id          String   @id @default(cuid())
  title       String
  company     String
  location    String
  salary      String?
  description String
  deadline    DateTime?
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

enum UserRole {
  USER
  ADMIN
  EDITOR
  MODERATOR
}
