# SohozKaj - Bengali Online Utility Platform
# .env.example - Copy to .env and fill with real values
# ⚠️ NEVER commit .env file to GitHub

# ============ SERVER ============
PORT=3000
NODE_ENV=development

# ============ DATABASE ============
# Using JSON file-based storage for simplicity
# For production, migrate to PostgreSQL
# DATABASE_URL=postgresql://user:pass@localhost:5432/sohozkaj

# ============ AUTHENTICATION ============
JWT_SECRET=your-secure-jwt-secret-key-min-32-chars
ADMIN_EMAIL=admin@sohozkaj.com
ADMIN_PASSWORD=secure-admin-password-change-this

# ============ AI SERVICES ============
# OpenAI / GPT for image editing and AI features
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_IMAGE_MODEL=dall-e-3

# Google Vision API for OCR
GOOGLE_VISION_API_KEY=your-google-vision-api-key

# Gemini API for Bengali AI processing (Future)
GEMINI_API_KEY=your-gemini-api-key-here

# ============ BACKGROUND REMOVAL ============
# Cutout.Pro API for professional background removal
CUTOUT_PRO_API_KEY=your-cutout-pro-api-key

# Remove.bg API (alternative provider)
REMOVEBG_API_KEY=your-remove-bg-api-key

# ============ FILE STORAGE ============
# S3 / MinIO for file uploads (optional)
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=sohozkaj-files
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key

# ============ EMAIL / NOTIFICATIONS ============
# SMTP for sending emails
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@sohozkaj.com

# ============ RATE LIMITING ============
# Max requests per minute per IP
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============ FILE UPLOAD LIMITS ============
MAX_FILE_SIZE_MB=60
MAX_IMAGE_DIMENSION=8000

# ============ FEATURE FLAGS ============
FEATURE_AI_EDITING=true
FEATURE_BACKGROUND_REMOVAL=true
FEATURE_OCR=true
FEATURE_PDF_GENERATION=true
CREDIT_SYSTEM_ENABLED=true

# ============ LOGGING ============
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# ============ SECURITY ============
# CORS settings
CORS_ORIGIN=http://localhost:3000
# For production: CORS_ORIGIN=https://sohozkaj.com

# ============ GEMINI API (FUTURE) ============
# For advanced Bengali language processing
# GEMINI_PROJECT_ID=your-google-cloud-project
# GEMINI_LOCATION=us-central1
