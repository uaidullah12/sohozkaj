# SohozKaj - Bengali Online Utility Platform
# .env.example - Copy to .env and fill with real values
# ⚠️ NEVER commit .env file to GitHub

# ============ SERVER ============
PORT=3000
NODE_ENV=development

# ============ AUTHENTICATION ============
JWT_SECRET=your-secure-jwt-secret-key-min-32-chars-change-this
ADMIN_EMAIL=admin@sohozkaj.com
ADMIN_PASSWORD=secure-admin-password-change-this

# ============ AI SERVICES ============
# OpenAI / GPT for image editing and AI features
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_IMAGE_MODEL=dall-e-3

# Google Vision API for OCR (ছবি থেকে লেখা)
GOOGLE_VISION_API_KEY=your-google-vision-api-key

# Gemini API for Bengali AI processing (Future)
GEMINI_API_KEY=your-gemini-api-key-here

# ============ BACKGROUND REMOVAL ============
# Cutout.Pro API for professional background removal
CUTOUT_PRO_API_KEY=your-cutout-pro-api-key

# Remove.bg API (alternative provider)
REMOVEBG_API_KEY=your-remove-bg-api-key

# ============ RATE LIMITING ============
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============ FILE UPLOAD LIMITS ============
MAX_FILE_SIZE_MB=60
MAX_IMAGE_DIMENSION=8000

# ============ FEATURE FLAGS ============
FEATURE_AI_EDITING=true
FEATURE_BACKGROUND_REMOVAL=true
FEATURE_OCR=true
FEATURE_PDF_GENERATION=true
CREDIT_SYSTEM_ENABLED=true

# ============ SECURITY ============
CORS_ORIGIN=http://localhost:3000